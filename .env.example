# Copia este archivo como .env y completa con tus datos.
# (Supabase -> Project Settings -> API)

PORT=3000

SUPABASE_URL=https://TU_PROYECTO.supabase.co
# Usa la SERVICE ROLE KEY solo en el backend. NUNCA la pongas en el frontend Flutter.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Secreto para firmar los tokens JWT del login. Usa una cadena larga y aleatoria.
JWT_SECRET=cambia_esto_por_una_cadena_larga_y_secreta
# Duracion del token (formato de la libreria jsonwebtoken: 1h, 8h, 7d, ...)
JWT_EXPIRES_IN=8h
